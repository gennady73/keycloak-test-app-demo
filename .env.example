# Copy to .env and edit. .env is git-ignored.
# Address the containers are published on. It must be in the certificate's subject alternative names
# (scripts/gen_certs.py puts HOST_IP, 127.0.0.1 and localhost in it).
HOST_IP=127.0.0.1
# Bootstrap admin password of the test containers. Test servers only.
KC_ADMIN_PASSWORD=change-me-test-only
# Image repository and tags. Air-gapped: use the name your local registry holds, e.g. registry.local:5000/keycloak/keycloak
# (or the RHBK image, e.g. registry.redhat.io/rhbk/keycloak-rhel9 with its tag). Compose builds kc-local:<tag> from it.
KC_IMAGE=docker.io/keycloak/keycloak
KC_TAG_2608=26.0.8-1
KC_TAG_262=26.2.5-0
KC_TAG_266=26.6.4-1
