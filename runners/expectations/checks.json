{
  "_comment": "Expectations as data. 'rules' are tried in order; the first whose min/max (inclusive, server version) fits applies. An empty rule list means 'recorded': the value is shown and compared across servers, but no verdict is made because no documented expectation exists yet.",
  "C16": {
    "title": "Direct access grant with wrong password",
    "doc": "UG26.6 \u00a72.10.38",
    "rules": [
      {
        "max": "26.6.1",
        "expect": {
          "http_status": 401,
          "error": "invalid_grant"
        }
      },
      {
        "min": "26.6.2",
        "expect": {
          "http_status": 400,
          "error": "invalid_grant"
        }
      }
    ]
  },
  "F1": {
    "title": "Authorization code flow with client secret",
    "doc": "design v0.3 \u00a77 F1",
    "rules": [
      {
        "expect": {
          "token_obtained": true,
          "issuer_matches": true,
          "audience_ok": true
        }
      }
    ]
  },
  "F2": {
    "title": "Refresh token grant",
    "doc": "design v0.3 \u00a77 F2",
    "rules": [
      {
        "expect": {
          "refreshed": true
        }
      }
    ]
  },
  "F4": {
    "title": "Format of session_state and sid",
    "doc": "UG26.6 \u00a72.10.11",
    "rules": [
      {
        "max": "26.6.1",
        "expect": {
          "sid_format": "uuid",
          "session_state_format": "uuid"
        }
      },
      {
        "min": "26.6.2",
        "expect": {
          "sid_format": "base64-24",
          "session_state_format": "base64-24"
        }
      }
    ]
  },
  "F5": {
    "title": "Client credentials (service account) token",
    "doc": "design v0.3 \u00a77 F5; UG26.2 \u00a72.9.7",
    "rules": [
      {
        "expect": {
          "http_status": 200,
          "token_type": "Bearer",
          "issuer_matches": true
        }
      }
    ]
  },
  "D3": {
    "title": "Path probes: '//', '..', ';' (encoded slash is recorded only)",
    "doc": "UG26.4 \u00a72.6.1 ('..', '//' from 26.4.4); semicolon from 26.4.9 (design v0.3 C3; UG26.4 \u00a72.11.3; UG26.6 \u00a72.10.48)",
    "rules": [
      {
        "max": "26.4.3",
        "expect": {
          "plain": 200,
          "double_slash": 200,
          "dot_dot": 200,
          "semicolon": 200
        }
      },
      {
        "min": "26.4.4",
        "max": "26.4.8",
        "expect": {
          "plain": 200,
          "double_slash": 400,
          "dot_dot": 400,
          "semicolon": 200
        }
      },
      {
        "min": "26.4.9",
        "expect": {
          "plain": 200,
          "double_slash": 400,
          "dot_dot": 400,
          "semicolon": 400
        }
      }
    ]
  },
  "S2": {
    "title": "SAML SP-initiated login accepted (response validated by the library)",
    "doc": "design v0.3 \u00a77 (SAML); no documented difference 26.0-26.6 for Keycloak acting as IdP (UG26.4 \u00a72.15.23 only with Encrypt Assertions)",
    "rules": [
      {
        "expect": {
          "login_ok": true,
          "in_response_to_matches": true
        }
      }
    ]
  },
  "S3": {
    "title": "SAML NameID and attribute delivered",
    "doc": "as S2",
    "rules": [
      {
        "expect": {
          "name_id_present": true,
          "name_id_is_username": true,
          "username_attribute_present": true
        }
      }
    ]
  }
}